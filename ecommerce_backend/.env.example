# Copier ce fichier en .env et remplir les vraies valeurs.
# .env ne doit JAMAIS être commité (déjà dans .gitignore).

# --- Core Django ---
SECRET_KEY=generer-une-vraie-cle-aleatoire-longue
DEBUG=False
ALLOWED_HOSTS=api.shopci.com,localhost,127.0.0.1

# --- Base de données (Neon / tout Postgres compatible) ---
# Format : postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- CORS : domaines du frontend autorisés à appeler l'API (séparés par des virgules) ---
CORS_ALLOWED_ORIGINS=https://shopci.com,https://www.shopci.com

# --- Email (réinitialisation de mot de passe, notifications) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@shopci.com
FRONTEND_URL=https://shopci.com

# --- Médias (Cloudinary) ---
# Toutes ces variables sont OBLIGATOIRES en production (Render).
# En local avec DEBUG=True et CLOUDINARY_URL vide = stockage disque local (/media/).
#
# Format CLOUDINARY_URL : cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Les 3 variables ci-dessous doivent correspondre aux valeurs dans CLOUDINARY_URL
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret

# --- Google OAuth (doit être le MÊME Client ID que côté shopci-web/.env) ---
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

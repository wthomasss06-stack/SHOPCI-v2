# Copier ce fichier en .env et remplir les vraies valeurs.
# .env ne doit JAMAIS être commité (déjà dans .gitignore).

# --- Core Django ---
SECRET_KEY=generer-une-vraie-cle-aleatoire-longue
DEBUG=False
ALLOWEALLOWED_HOSTS=api.shopci.com,localhost,127.0.0.1

# --- Base de données (Neon / tout Postgres compatible) ---
# Format : postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- CORS : domaines du frontend autorisés à appeler l'API (séparés par des virgules) ---
CORS_ALLOWED_ORIGINS=https://shopci.com,https://www.shopci.com

# --- Email (réinitialisation de mot de passe, notifications) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@shopci.com
FRONTEND_URL=https://shopci.com
---
# Vide en dev = stockage disque local (ne sert RIEN si DEBUG=False, à ne pas laisser vide en prod)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
